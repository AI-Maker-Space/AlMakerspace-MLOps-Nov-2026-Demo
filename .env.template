# Copy this file to `.env` at the repo root and fill in the key. `.env` is
# gitignored; never commit it.
#
# All three notebooks read this file through helpers.nb.bootstrap(). LiteLLM
# picks the provider from the model string.

# The chat model the agents in 01 and 02 use. Must be able to call tools.
OPENAI_API_KEY=sk-...
LLM_MODEL=openai/gpt-4.1-mini

# The vision model 03 uses to read a chart's pixels. Same key, same provider.
VLM_MODEL=openai/gpt-4.1-mini

# Embeddings for 03 are local (bge-small and CLIP through fastembed) and need
# no key. Leave EMBED_MODEL unset.
